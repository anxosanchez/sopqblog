# =============================================================================
# ENVIRONMENT CONFIGURATION - PROCESS SIMULATION BLOG
# =============================================================================

# Google Gemini API Key for automatic taxonomy, summaries, and YouTube SEO
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 OAuth2 Configuration
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json

# Default simulation repository paths
SIMULATION_DRIVE_ROOT=https://drive.google.com/drive/folders/your_folder_id
COLAB_NOTEBOOK_ROOT=https://colab.research.google.com/drive/your_notebook_id

# Quarto binary path override (optional)
# QUARTO_PATH=/Applications/Positron.app/Contents/Resources/app/quarto/bin/quarto

# Telegram Editor Notification Bot (alerts the editor when a new post is proposed)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id
